PORT=3000
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe
ANSWER_MODEL=gpt-4.1-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
EMBEDDING_MODEL=text-embedding-3-small
# Set true only when the site is served over HTTPS.
AUTH_SECURE_COOKIES=false
# Session lifetime: 8 hours.
AUTH_SESSION_TTL_SECONDS=28800

# Phase 6A benchmark
BENCHMARK_DATASET_DIR=data/benchmark/runtime
BENCHMARK_GENERATOR_MODEL=gpt-4.1-mini
BENCHMARK_NEGATIVE_STRONG_SCORE=0.78

# Phase 6A benchmark generator
BENCHMARK_GENERATOR_MODEL=gpt-4.1-mini
BENCHMARK_BATCH_SIZE=10
BENCHMARK_MAX_ATTEMPTS=8
STT_PROMPT=Wine.md, WINE AI, Moldova, Fetească Neagră, Fetească Albă, Fetească Regală, Rară Neagră, Viorica, Cricova, Purcari, Castel Mimi, Château Vartely, Et Cetera, Ștefan Vodă, Valul lui Traian, Codru.

# MVP assistant panel and temporary JSON knowledge store
ASSISTANT_SETTINGS_FILE=./data/settings/assistant.json
KNOWLEDGE_EXTRACTION_FILE=./data/knowledge/runtime/knowledge.json
KNOWLEDGE_EXTRACTION_MODEL=gpt-4.1-mini
